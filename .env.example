PORT=3000
DATA_DIR=./data

# Required for encrypting MongoDB connection strings. Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY=replace-with-a-32-byte-or-longer-secret

# Required for signing session JWTs. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-a-32-byte-or-longer-secret

# Set true only for local UI development without Docker access.
DEMO_MODE=false

# Optional: restrict CORS to a specific origin when stackvia is accessed
# from a different domain than it is served from. Leave unset when using
# the built-in static file serving (the normal production setup).
# ALLOWED_ORIGIN=https://stackvia.example.com
